# Connexion de l'application (rôle soumis au cloisonnement RLS)
DATABASE_URL=postgres://qualiopix_app:qualiopix_app@localhost:5433/qualiopix
# Connexion propriétaire, utilisée uniquement pour les migrations
DATABASE_ADMIN_URL=postgres://qualiopix:qualiopix@localhost:5433/qualiopix

# Bases de test (npm test)
TEST_DATABASE_URL=postgres://qualiopix_app:qualiopix_app@localhost:5433/qualiopix_test
TEST_DATABASE_ADMIN_URL=postgres://qualiopix:qualiopix@localhost:5433/qualiopix_test
